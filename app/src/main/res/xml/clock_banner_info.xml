<?xml version="1.0" encoding="utf-8"?>
<!-- Wide clock: one row high by default, stretch it sideways to fill the screen. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:description="@string/widget_banner_description"
    android:initialLayout="@layout/widget_banner"
    android:minHeight="40dp"
    android:minResizeHeight="40dp"
    android:minResizeWidth="150dp"
    android:minWidth="220dp"
    android:previewLayout="@layout/widget_banner"
    android:resizeMode="horizontal|vertical"
    android:targetCellHeight="1"
    android:targetCellWidth="4"
    android:updatePeriodMillis="1800000"
    android:widgetCategory="home_screen" />