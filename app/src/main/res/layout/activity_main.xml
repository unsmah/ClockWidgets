<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textColor="@color/text_primary"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            style="@style/BodyText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="4dp"
            android:text="@string/main_subtitle" />

        <TextView
            style="@style/SectionTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/section_previews" />

        <!-- Digital -->
        <LinearLayout
            style="@style/Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                style="@style/WidgetCardLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/widget_digital_name" />

            <TextView
                style="@style/WidgetCardSub"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/widget_digital_description" />

            <FrameLayout
                android:id="@+id/preview_digital"
                android:layout_width="match_parent"
                android:layout_height="110dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/preview_backdrop" />

            <Button
                android:id="@+id/add_digital"
                style="@style/PrimaryButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/add_to_home" />
        </LinearLayout>

        <!-- Analog -->
        <LinearLayout
            style="@style/Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp">

            <TextView
                style="@style/WidgetCardLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/widget_analog_name" />

            <TextView
                style="@style/WidgetCardSub"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/widget_analog_description" />

            <FrameLayout
                android:id="@+id/preview_analog"
                android:layout_width="match_parent"
                android:layout_height="140dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/preview_backdrop" />

            <Button
                android:id="@+id/add_analog"
                style="@style/PrimaryButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/add_to_home" />
        </LinearLayout>
    <!-- Minimal -->
        <LinearLayout
            style="@style/Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp">

            <TextView
                style="@style/WidgetCardLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/widget_minimal_name" />

            <TextView
                style="@style/WidgetCardSub"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/widget_minimal_description" />

            <FrameLayout
                android:id="@+id/preview_minimal"
                android:layout_width="match_parent"
                android:layout_height="80dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/preview_backdrop" />

            <Button
                android:id="@+id/add_minimal"
                style="@style/PrimaryButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/add_to_home" />
        </LinearLayout>

        <TextView
            style="@style/SectionTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/section_placed" />

        <TextView
            android:id="@+id/placed_empty"
            style="@style/BodyText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/placed_empty" />

        <LinearLayout
            android:id="@+id/placed_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <TextView
            style="@style/SectionTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/help_title" />

        <TextView
            style="@style/BodyText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="16dp"
            android:text="@string/help_body" />
    </LinearLayout>
</ScrollView>