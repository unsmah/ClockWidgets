<?xml version="1.0" encoding="utf-8"?>
<!-- Wide clock: time and date side by side, made for short and wide widgets.
     The date column disappears on its own when the widget is too narrow. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <include
        layout="@layout/widget_part_background"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="12dp">

        <include
            layout="@layout/widget_part_time"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1.1" />

        <TextClock
            android:id="@+id/widget_date"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="0.9"
            android:ellipsize="end"
            android:fontFamily="sans-serif"
            android:format12Hour="EEEE, d MMM"
            android:format24Hour="EEEE, d MMM"
            android:gravity="center"
            android:maxLines="1"
            android:textColor="@color/widget_subtext_on_dark"
            android:textSize="12sp" />
    </LinearLayout>
</FrameLayout>