<?xml version="1.0" encoding="utf-8"?>
<!-- Analog clock widget: AnalogClock draws and ticks itself inside the launcher process. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <FrameLayout
        android:id="@+id/bg_dark"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/widget_bg_dark" />

    <FrameLayout
        android:id="@+id/bg_light"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/widget_bg_light"
        android:visibility="gone" />

    <FrameLayout
        android:id="@+id/bg_transparent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/widget_bg_transparent"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="8dp">

        <AnalogClock
            android:id="@+id/widget_analog"
            android:layout_width="96dp"
            android:layout_height="96dp"
            android:background="@drawable/widget_dial" />

        <TextClock
            android:id="@+id/widget_date"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:format12Hour="EEE, d MMM"
            android:format24Hour="EEE, d MMM"
            android:gravity="center"
            android:maxLines="1"
            android:paddingTop="6dp"
            android:textColor="@color/widget_subtext_on_dark"
            android:textSize="12sp" />
    </LinearLayout>
</FrameLayout>