<?xml version="1.0" encoding="utf-8"?>
<!-- Duo clock: analog dial on top, digital time and date below. The dial takes the space that
     the two text lines leave over. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <include
        layout="@layout/widget_part_background"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="8dp">

        <AnalogClock
            android:id="@+id/widget_analog"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="@drawable/widget_dial" />

        <include
            layout="@layout/widget_part_time"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp" />

        <TextClock
            android:id="@+id/widget_date"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:format12Hour="EEEE, d MMM"
            android:format24Hour="EEEE, d MMM"
            android:gravity="center"
            android:maxLines="1"
            android:textColor="@color/widget_subtext_on_dark"
            android:textSize="12sp" />
    </LinearLayout>
</FrameLayout>