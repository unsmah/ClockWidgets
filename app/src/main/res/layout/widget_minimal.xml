<?xml version="1.0" encoding="utf-8"?>
<!-- Minimal clock: transparent by default, big time only. The background layers are written out
     here instead of using the shared part so that the transparent layer is the visible one in
     the widget picker preview. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <FrameLayout
        android:id="@+id/bg_dark"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/widget_bg_dark"
        android:visibility="gone" />

    <FrameLayout
        android:id="@+id/bg_light"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/widget_bg_light"
        android:visibility="gone" />

    <FrameLayout
        android:id="@+id/bg_transparent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/widget_bg_transparent" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="8dp">

        <include
            layout="@layout/widget_part_time"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextClock
            android:id="@+id/widget_date"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:format12Hour="EEE, d MMM"
            android:format24Hour="EEE, d MMM"
            android:gravity="center"
            android:maxLines="1"
            android:paddingTop="2dp"
            android:textColor="@color/widget_subtext_on_dark"
            android:textSize="12sp"
            android:visibility="gone" />
    </LinearLayout>
</FrameLayout>