<?xml version="1.0" encoding="utf-8"?>
<!-- Minimal clock widget: transparent by default, one big line of text. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <FrameLayout
        android:id="@+id/bg_dark"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/widget_bg_dark"
        android:visibility="gone" />

    <FrameLayout
        android:id="@+id/bg_light"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/widget_bg_light"
        android:visibility="gone" />

    <FrameLayout
        android:id="@+id/bg_transparent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/widget_bg_transparent" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="8dp">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextClock
                android:id="@+id/widget_time_24"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="sans-serif-light"
                android:format12Hour="HH:mm"
                android:format24Hour="HH:mm"
                android:gravity="center"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textColor="@color/widget_text_on_dark"
                android:textSize="40sp" />

            <TextClock
                android:id="@+id/widget_time_24s"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="sans-serif-light"
                android:format12Hour="HH:mm:ss"
                android:format24Hour="HH:mm:ss"
                android:gravity="center"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textColor="@color/widget_text_on_dark"
                android:textSize="40sp"
                android:visibility="gone" />

            <TextClock
                android:id="@+id/widget_time_12"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="sans-serif-light"
                android:format12Hour="h:mm a"
                android:format24Hour="h:mm a"
                android:gravity="center"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textColor="@color/widget_text_on_dark"
                android:textSize="40sp"
                android:visibility="gone" />

            <TextClock
                android:id="@+id/widget_time_12s"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="sans-serif-light"
                android:format12Hour="h:mm:ss a"
                android:format24Hour="h:mm:ss a"
                android:gravity="center"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textColor="@color/widget_text_on_dark"
                android:textSize="40sp"
                android:visibility="gone" />
        </FrameLayout>

        <TextClock
            android:id="@+id/widget_date"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:format12Hour="EEE, d MMM"
            android:format24Hour="EEE, d MMM"
            android:gravity="center"
            android:maxLines="1"
            android:paddingTop="2dp"
            android:textColor="@color/widget_subtext_on_dark"
            android:textSize="12sp"
            android:visibility="gone" />
    </LinearLayout>
</FrameLayout>