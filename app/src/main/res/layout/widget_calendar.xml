<?xml version="1.0" encoding="utf-8"?>
<!-- Date focus clock: big day number with the weekday above and the month below, plus a smaller
     time at the bottom. The day number grows with the widget. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <include
        layout="@layout/widget_part_background"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="10dp">

        <TextClock
            android:id="@+id/widget_weekday"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="sans-serif"
            android:format12Hour="EEEE"
            android:format24Hour="EEEE"
            android:gravity="center"
            android:maxLines="1"
            android:textColor="@color/widget_subtext_on_dark"
            android:textSize="13sp" />

        <TextClock
            android:id="@+id/widget_day"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="sans-serif-light"
            android:format12Hour="d"
            android:format24Hour="d"
            android:gravity="center"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textColor="@color/accent_blue"
            android:textSize="48sp" />

        <TextClock
            android:id="@+id/widget_date"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="sans-serif"
            android:format12Hour="MMMM yyyy"
            android:format24Hour="MMMM yyyy"
            android:gravity="center"
            android:maxLines="1"
            android:textColor="@color/widget_subtext_on_dark"
            android:textSize="13sp" />

        <include
            layout="@layout/widget_part_time"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp" />
    </LinearLayout>
</FrameLayout>