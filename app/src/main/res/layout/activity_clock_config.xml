<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/config_title"
            android:textColor="@color/text_primary"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            style="@style/ConfigLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/cfg_preview" />

        <FrameLayout
            android:id="@+id/config_preview"
            android:layout_width="match_parent"
            android:layout_height="140dp"
            android:background="@drawable/preview_backdrop" />

        <TextView
            android:id="@+id/format_label"
            style="@style/ConfigLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/cfg_time_format" />

        <RadioGroup
            android:id="@+id/format_group"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/radio_24"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/cfg_format_24"
                android:textColor="@color/text_primary" />

            <RadioButton
                android:id="@+id/radio_12"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/cfg_format_12"
                android:textColor="@color/text_primary" />
        </RadioGroup>
        <TextView
            android:id="@+id/accent_label"
            style="@style/ConfigLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/cfg_accent" />

        <LinearLayout
            android:id="@+id/accent_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:minHeight="40dp"
            android:orientation="horizontal" />

        <TextView
            style="@style/ConfigLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/cfg_background" />

        <RadioGroup
            android:id="@+id/background_group"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/radio_bg_dark"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/cfg_bg_dark"
                android:textColor="@color/text_primary" />

            <RadioButton
                android:id="@+id/radio_bg_light"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/cfg_bg_light"
                android:textColor="@color/text_primary" />

            <RadioButton
                android:id="@+id/radio_bg_transparent"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/cfg_bg_transparent"
                android:textColor="@color/text_primary" />
        </RadioGroup>

        <CheckBox
            android:id="@+id/check_seconds"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/cfg_seconds"
            android:textColor="@color/text_primary" />

        <CheckBox
            android:id="@+id/check_date"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/cfg_show_date"
            android:textColor="@color/text_primary" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="end"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn_cancel"
                style="@style/PrimaryButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/cfg_cancel" />

            <Button
                android:id="@+id/btn_save"
                style="@style/PrimaryButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="@string/cfg_save" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>