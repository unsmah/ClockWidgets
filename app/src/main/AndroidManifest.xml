<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android" package="com.example.clockwidgets">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:theme="@style/Theme.ClockWidgets">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ClockConfigActivity"
            android:exported="true"
            android:label="@string/config_title"
            android:theme="@style/Theme.ClockWidgets.Config">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

        <!-- Digital clock widget: time + weekday/date -->
        <receiver
            android:name=".widget.DigitalClockWidgetProvider"
            android:exported="false"
            android:label="@string/widget_digital_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/clock_digital_info" />
        </receiver>

        <!-- Analog clock widget: analog dial + date -->
        <receiver
            android:name=".widget.AnalogClockWidgetProvider"
            android:exported="false"
            android:label="@string/widget_analog_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/clock_analog_info" />
        </receiver>

        <!-- Minimal clock widget: transparent, time only -->
        <receiver
            android:name=".widget.MinimalClockWidgetProvider"
            android:exported="false"
            android:label="@string/widget_minimal_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/clock_minimal_info" />
        </receiver>

        <!-- Wide clock widget: time and date side by side -->
        <receiver
            android:name=".widget.BannerClockWidgetProvider"
            android:exported="false"
            android:label="@string/widget_banner_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/clock_banner_info" />
        </receiver>

        <!-- Date focus clock widget: big day number -->
        <receiver
            android:name=".widget.CalendarClockWidgetProvider"
            android:exported="false"
            android:label="@string/widget_calendar_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/clock_calendar_info" />
        </receiver>

        <!-- Duo clock widget: analog dial plus digital time -->
        <receiver
            android:name=".widget.DuoClockWidgetProvider"
            android:exported="false"
            android:label="@string/widget_duo_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/clock_duo_info" />
        </receiver>
    </application>
</manifest>